# Copy this file to .env. Keep .env private and outside version control.
TSO_PUBLIC_ORIGIN=https://organizer.example.com
TSO_ALLOWED_HOSTS=organizer.example.com
# Generate exactly once with: openssl rand -base64 48
TSO_MASTER_KEY=replace-with-output-of-openssl-rand-base64-48
TSO_TELEGRAM_API_ID=123456
TSO_TELEGRAM_API_HASH=replace-with-server-telegram-api-hash
TSO_ALLOW_REGISTRATION=true
TSO_COOKIE_SECURE=true
TSO_SESSION_ABSOLUTE_SECONDS=2592000
TSO_SESSION_IDLE_SECONDS=604800
TSO_MAX_ACTIVE_SESSIONS=10
TSO_SCAN_MAX_MESSAGES=10000
TSO_SCAN_MAX_RUNTIME_SECONDS=3600
TSO_SCAN_SLICE_MAX_PAGES=5
TSO_SCAN_SLICE_SECONDS=30
TSO_SCAN_MAX_STREAMS_PER_USER=3
TSO_TELEGRAM_CONNECT_TIMEOUT_SECONDS=15
TSO_TELEGRAM_DISCONNECT_TIMEOUT_SECONDS=5

# Use a long URL-safe value (letters and digits) because Compose places it in
# the PostgreSQL connection URL as well as the database container.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password

# Host port for the internal HTTP service. Put a TLS reverse proxy or load
# balancer in front of this port. Keep the default loopback bind when the TLS
# proxy runs on the same host; it must overwrite X-Forwarded-For with the
# external client chain and preserve the original Host header.
TSO_HTTP_BIND=127.0.0.1
TSO_HTTP_PORT=8080
